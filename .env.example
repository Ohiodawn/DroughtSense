# Flask Config
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key

# AI Inference (Phase 5+)
# AMD_VLLM_BASE_URL="http://your-amd-ip:8000/v1"
# AMD_VLLM_API_KEY="your-api-key"

# Local LLM Provider (Optional)
# Options: ollama, llama.cpp, mock (default)
LOCAL_AI_PROVIDER=mock

# Geocoding / NASA (Optional keys)
# Set GOOGLE_MAPS_API_KEY to use Google Maps instead of Nominatim
GOOGLE_MAPS_API_KEY=
