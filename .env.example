# Flask Config
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key

# AI Inference (AMD MI300X via vLLM)
# Point this to your AMD Developer Cloud droplet
AMD_VLLM_BASE_URL="http://your-amd-ip:8000/v1"
AMD_VLLM_API_KEY="your-api-key"

# Geocoding / NASA (Optional keys)
# Set GOOGLE_MAPS_API_KEY to use Google Maps instead of Nominatim
GOOGLE_MAPS_API_KEY=
